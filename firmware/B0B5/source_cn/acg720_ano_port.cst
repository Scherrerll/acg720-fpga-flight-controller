// 保留基线版本的高扇出复位网络物理分配，不改变原有时钟资源约束。
CLOCK_LOC "observer_reset" BUFG = CE|SR|LOGIC;

// 水面双路使用 P7 对应的 A13/A14；IO 电平约束和具体接口对应关系见提交说明。
