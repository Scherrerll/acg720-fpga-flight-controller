+ reg [31:0] age=0,highwater=0;
+ reg seen_set=0;
+ reg [127:0] frame=0;
+ reg [15:0] crc=16'hffff,reply_crc=16'hffff;
+ reg [2:0] state=0;
+ reg [7:0] status=0;
+ wire [7:0] opcode=frame[103:96];
+ wire [31:0] sequence_id=frame[79:48];
+ wire [15:0] proposed_p=frame[47:32],proposed_i=frame[31:16];
