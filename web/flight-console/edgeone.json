{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {"regions":{"overseas":["ap-hongkong"]}},
  "rewrites": [{"source":"/logs","destination":"/index.html"},{"source":"/parameters","destination":"/parameters.html"}],
  "headers": [{"source":"/*","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'"},
    {"key":"Cache-Control","value":"no-store"}
  ]}]
}
